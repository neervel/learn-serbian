{
  "name": "learn-serbian",
  "version": "1.0.0",
  "description": "Telegram bot for learning Serbian vocabulary",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "build-lemmas": "node scripts/build-lemmas.ts",
    "normalize-words": "node scripts/normalize-words.ts",
    "import-words": "node scripts/import-words.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
